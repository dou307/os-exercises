 "stemHtml": "<p>操作系统是对（　）进行管理的软件。</p>",
 "stemText": "操作系统是对（ ）进行管理的软件。",
 "options": [
  {
   "key": "A",
   "html": "软件",
   "text": "软件"
  },
  {
   "key": "B",
   "html": "硬件",
